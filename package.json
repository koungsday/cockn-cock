{
  "name": "cockcockcock",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-build.mjs",
    "live:build": "node worker/prepare.mjs",
    "live:dev": "npm run live:build && wrangler dev --config worker/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "live:db": "wrangler d1 migrations apply DB --config worker/wrangler.jsonc --local",
    "live:test": "node --test worker/*.test.mjs pages/*.test.mjs",
    "live:verify": "node scripts/verify-live.mjs",
    "deploy": "node scripts/deploy-live.mjs",
    "console:password": "node scripts/console-password.mjs"
  },
  "devDependencies": {
    "wrangler": "4.168.0"
  }
}
