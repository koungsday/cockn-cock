{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cockcockcock",
  "main": "index.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/index.html", "/club-ui/*", "/clubs", "/clubs/*", "/api", "/api/*", "/vote/*", "/notice/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cockcockcock",
      "migrations_dir": "migrations"
    }
  ]
}
